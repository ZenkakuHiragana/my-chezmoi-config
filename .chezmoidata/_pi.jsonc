{
  "pi_agent": {
    "general_fast": {
      "model": "openai-codex/gpt-5.6-luna",
      "thinking": "medium"
    },
    "general_strong": {
      "model": "openai-codex/gpt-5.6-luna",
      "thinking": "max"
    },
    "requirement_reviewer": {
      "model": "openai-codex/gpt-5.6-luna",
      "thinking": "high"
    },
    "review_audit": {
      "model": "openai-codex/gpt-5.6-luna",
      "thinking": "low"
    }
  },
  "pi": {
    "mcp": {
      "exa": {
        "url": "https://mcp.exa.ai/mcp",
      },
    },
    "tool_filter": {
      "read": {
        "allow": [
          "~/.local/share/chezmoi/.opencode/local-failure-logs/**"
        ],
        "deny": [
          "~/.ssh",
          "~/.ssh/**",
          "~/.bashrc",
          "~/.bash_profile",
          "~/.profile",
          "~/.zshrc",
          "~/.zprofile",
          "~/.aws",
          "~/.aws/**",
          "~/.config/gcloud",
          "~/.config/gcloud/**",
          "~/.kube/config",
          "~/.npmrc",
          "~/.pypirc",
          "~/.git-credentials",
          "~/.netrc"
        ],
      },
      "write": {
        "allow": [
          "~/.local/share/chezmoi/.opencode/local-failure-logs/**",
          "~/.config/opencode/KNOWLEDGE.yml",
          "~/.config/opencode/KNOWLEDGE.local.yml",
          "~/.config/opencode/knowledge-instructions/**",
          "~/AppData/Local/Temp/opencode/**",
          "/tmp/opencode/**",
          "/dev/null"
        ],
        "deny": [
          ".git",
          ".git/**"
        ],
        "outsideDefault": "deny",
      },
    },
  },
}
