{
  "claude": {
    // 初回生成時の fallback。既存の ~/.claude/settings.json に値があればそちらを保持する。
    "model": "sonnet",
    "agent": "build",
    "enabledPlugins": {
      "lua-lsp@claude-plugins-official": true,
    },
    // 初回生成時の fallback。Claude Code 側の切り替えで既存値が変わった場合は保持する。
    "effortLevel": "high",
    "autoUpdatesChannel": "latest",
    "showThinkingSummaries": true,
    "theme": "auto",
    "verbose": false,
    // Claude Code の設定変更で追加されたキー。並べ替え正規化の差分を防ぐため正本に持つ。
    "promptSuggestionEnabled": false,
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node",
              "args": [
                "-e",
                "let s='';process.stdin.on('data',c=>s+=c).on('end',()=>{let a='';try{a=JSON.parse(s).agent_type||''}catch(e){}if(a&&a!=='build')return;process.stdout.write(JSON.stringify({hookSpecificOutput:{hookEventName:'SessionStart',additionalContext:'システムプロンプトに記載の作業規則を忠実に遵守せよ。これらの規則は行動の参考ではなくユーザーによる明示的な意志でありユーザーが提示する行動義務である。規則からの逸脱はいかなる結果を提示したとしてもタスクの失敗を意味する。'}}))});",
              ],
              "timeout": 5,
            },
          ],
        },
      ],
    },
    "permissions": {
      // - Agent ... 残す。
      // - Artifact ... 消す。
      // - AskUserQuestion ... 残す。
      // - Bash / PowerShell ... OS ごとに使わない方を消す。"{shell:other}" は render-settings.js が
      //   targetTool (Windows なら PowerShell、それ以外なら Bash) の反対側に解決する。
      // - CronCreate / CronList / CronDelete ... 消す。
      // - DesignSync ... とりあえず残す。ciaude.ai/design を見てみると、何やらスライドのデザインや GUI アプリケーションのモックとか、そういうのもあるみたい。使用感を確認したい。
      // - Read / Glob / Grep / Edit / Write ... いる。
      // - EnterPlanMode / ExitPlanMode ... 残す。
      // - EnterWorktree / ExitWorktree ... まだ残す。
      // - LSP ... 残す。
      // - Monitor ... 一応残す。
      // - NotebookEdit ... 消す。
      // - PushNotification ... 一応残す。一度も使われないようなら消す。
      // - RemoteTrigger ... 消す。
      // - ReportFindings ... 一応残す。指摘事項の整形が勝手にされるらしい。
      // - ScheduleWakeup ... 消す。
      // - SendMessage ... 残す。
      // - Skill ... 残す。
      // - TaskCreate / TaskGet / TaskList / TaskUpdate ... 残す。
      // - TaskOutput ... 消す。
      // - TaskStop ... 残す。
      // - WebFetch / WebSearch ... 残す。
      "deny": [
        "DesignSync",
        "EnterWorktree",
        "ExitWorktree",
        "Monitor",
        "PushNotification",
        "ReportFindings",
        // ------------------
        "Artifact",
        "{shell:other}",
        "CronCreate",
        "CronDelete",
        "CronList",
        "NotebookEdit",
        "RemoteTrigger",
        "ScheduleWakeup",
        "TaskOutput",
        "Agent(Explore)",
        "Agent(Plan)",
        "Agent(general-purpose)",
      ],
    },
  },
  "claude_agent": {
    "general_fast": {
      "model": "sonnet",
      "effort": "high",
    },
    "general_strong": {
      "model": "opus",
      "effort": "high",
    },
    "requirement_reviewer": {
      "model": "opus",
      "effort": "high",
    },
    "review_audit": {
      "model": "opus",
      "effort": "high",
    },
  },
}
