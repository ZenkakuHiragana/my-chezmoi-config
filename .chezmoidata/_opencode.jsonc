{
  // "opencode_agent": {
  //   "general_fast": {
  //     "model": "opencode-go/gpt-5.6-luna",
  //     "reasoningEffort": "high",
  //   },
  //   "general_strong": {
  //     "model": "opencode-go/gpt-5.6-luna",
  //     "reasoningEffort": "max",
  //   },
  //   "requirement_reviewer": {
  //     "model": "opencode-go/gpt-5.6-luna",
  //     "reasoningEffort": "high",
  //   },
  //   "review_audit": {
  //     "model": "opencode-go/gpt-5.6-luna",
  //     "reasoningEffort": "high",
  //   },
  // },
  "opencode": {
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "small_model": "opencode/deepseek-v4-flash-free",
    "autoupdate": false,
    "agent": {
      "plan": {
        "disable": true,
      },
    },
    "compaction": {
      "auto": false,
      "prune": false,
    },
    "formatter": {
      "prettier": {
        "command": ["npx", "prettier", "--write", "$FILE"],
        "extensions": [
          ".md",
          ".markdown",
          ".yaml",
          ".yml",
          ".json",
          ".jsonc",
          ".js",
          ".mjs",
          ".cjs",
          ".ts",
          ".css",
          ".html",
          ".htm",
        ],
      },
    },
    "lsp": {},
    "plugin": [
      "@prevalentware/opencode-goal-plugin",
      "@cortexkit/opencode-magic-context",
      "opencode-with-claude",
    ],
    "mcp": {
      "skill-kb": {
        "type": "local",
        "command": [
          "node",
          "{file:~/.config/opencode/skill-kb-entrypoint.txt}",
        ],
        "timeout": 10000,
        "enabled": true,
      },
    },
    "provider": {
      "anthropic": {
        "options": {
          "baseURL": "http://127.0.0.1:3456",
          "apiKey": "claude",
        },
      },
      "github-copilot": {
        "models": {
          "gpt-5-mini": {
            "textVerbosity": "low",
          },
          "gpt-5.4": {
            "options": {
              "textVerbosity": "low",
            },
          },
          "gpt-5.4-mini": {
            "options": {
              "textVerbosity": "low",
            },
          },
        },
      },
      "openai": {
        "options": {
          "headerTimeout": false,
        },
        "models": {
          "gpt-5.4": {
            "options": {
              "textVerbosity": "low",
            },
          },
          "gpt-5.4-mini": {
            "options": {
              "textVerbosity": "low",
            },
          },
        },
      },
      "bailian-token-plan-personal": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "Qwen Cloud",
        "options": {
          "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
          "apiKey": "{env:QWEN_API_KEY}",
        },
        "models": {
          "qwen3.8-max-preview": {
            "name": "Qwen3.8 Max Preview",
            "limit": {
              "context": 1000000,
              "input": 983616,
              "output": 131072,
            },
            "options": {
              "thinking": {
                "type": "enabled",
                "budgetTokens": 99072,
              },
              "temperature": 0.6,
              "reasoning": true,
            },
          },
        },
      },
    },
    "tools": {
      "bash": true,
      "edit": true,
      "glob": true,
      "grep": true,
      "list": true,
      "lsp": true,
      "patch": true,
      "question": true,
      "read": true,
      "skill": true,
      "todoread": true,
      "todowrite": true,
      "webfetch": true,
      "websearch": true,
      "write": true,
    },
    "permission": {
      "bash": {
        "*": "allow",
        // 未知のコマンドは許可し、危険な操作だけ下で拒否・確認する。
        // これは bash のコマンド文字列照合であり、別の実行経路まで隔離するものではない。
        // git 操作系（書き込み: 拒否）
        "git add *": "deny",
        "git commit": "deny",
        "git commit *": "deny",
        "git restore *": "deny",
        "git checkout": "deny",
        "git checkout *": "deny",
        "git switch": "deny",
        "git switch *": "deny",
        "git merge": "deny",
        "git merge *": "deny",
        "git rebase": "deny",
        "git rebase *": "deny",
        "git stash": "deny",
        "git stash *": "deny",
        "git pull": "deny",
        "git pull *": "deny",
        "git cherry-pick": "deny",
        "git cherry-pick *": "deny",
        "git revert": "deny",
        "git revert *": "deny",
        "git reset --hard": "deny",
        "git reset --hard *": "deny",
        "git clean -fd": "deny",
        "git clean -fd *": "deny",
        "git clean -fdx": "deny",
        "git clean -fdx *": "deny",
        "git filter-branch": "deny",
        "git filter-branch *": "deny",
        "git push": "deny",
        "git push *": "deny",
        "git -C * add *": "deny",
        "git -C * commit": "deny",
        "git -C * commit *": "deny",
        "git -C * restore *": "deny",
        "git -C * checkout": "deny",
        "git -C * checkout *": "deny",
        "git -C * switch": "deny",
        "git -C * switch *": "deny",
        "git -C * merge": "deny",
        "git -C * merge *": "deny",
        "git -C * rebase": "deny",
        "git -C * rebase *": "deny",
        "git -C * stash": "deny",
        "git -C * stash *": "deny",
        "git -C * pull": "deny",
        "git -C * pull *": "deny",
        "git -C * cherry-pick": "deny",
        "git -C * cherry-pick *": "deny",
        "git -C * revert": "deny",
        "git -C * revert *": "deny",
        "git -C * reset --hard": "deny",
        "git -C * reset --hard *": "deny",
        "git -C * clean -fd": "deny",
        "git -C * clean -fd *": "deny",
        "git -C * clean -fdx": "deny",
        "git -C * clean -fdx *": "deny",
        "git -C * filter-branch": "deny",
        "git -C * filter-branch *": "deny",
        "git -C * push": "deny",
        "git -C * push *": "deny",
        // ファイル削除禁止
        "rm *": "deny",
        // ビルドツール: Cargo（公開操作）
        "cargo login": "deny",
        "cargo login *": "deny",
        "cargo publish": "deny",
        "cargo publish *": "ask",
        // ビルドツール: dotnet CLI（公開操作）
        "dotnet push": "deny",
        "dotnet push *": "deny",
        "/mnt/c/Program\\ Files/dotnet/dotnet.exe push": "deny",
        "/mnt/c/Program\\ Files/dotnet/dotnet.exe push *": "deny",
        "\"/mnt/c/Program Files/dotnet/dotnet.exe\" push": "deny",
        "\"/mnt/c/Program Files/dotnet/dotnet.exe\" push *": "deny",
      },
      "webfetch": "allow",
      "websearch": "allow",
      "codesearch": "allow",
      "skill": {
        "*": "allow",
        "cmd-*": "deny",
      },
      "external_directory": {
        "*": "ask",
        "~": "deny",
        "/": "deny",
        "~/.agents/skills/**": "allow",
        "~/.claude/skills/**": "allow",
      },
      "orchestrator": {
        "orch-local-investigator": "deny",
        "orch-public-researcher": "deny",
      },
    },
  },
}
