{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "compaction": {
    "enabled": true
  },
  "dreamer": {
    "disable": true,
    "inject_docs": false
  },
  "embedding": {
    "provider": "off"
  },
  "memory": {
    "enabled": false,
    "auto_promote": false,
    "auto_search": {
      "enabled": false
    },
    "git_commit_indexing": {
      "enabled": false
    }
  },
  "commit_cluster_trigger": {
    "enabled": true,
    "min_clusters": 3
  },
  "prompt_surface": {
    "default": "light"
  },
  "temporal_awareness": true,
  "todowrite": {
    "enabled": false
  }
}
