{{- $filename := base .chezmoi.targetFile -}}
{{- $name := trimSuffix (ext $filename) $filename -}}
{{- $agent := index .agents $name -}}
{{- $profile := index .modelProfiles $agent.modelProfile -}}
{{- $bodyTemplate := printf "prompt/agents/%s.md" $name -}}
---
description: {{ $agent.description | quote }}
mode: subagent
model: {{ template "prompt/agents/resolve.tmpl" (dict "values" $profile "harness" "opencode") }}
variant: {{ template "prompt/agents/resolve.tmpl" (dict "values" $agent.effort "harness" "opencode") }}
permission:
  edit: deny
  task: deny
---

{{ includeTemplate $bodyTemplate . }}
