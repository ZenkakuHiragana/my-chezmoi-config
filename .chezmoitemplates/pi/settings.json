{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "showHardwareCursor": false,
  "enableSkillCommands": false,
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-subagents-lite",
    "npm:pi-mcp-adapter",
    "npm:pi-tool-display",
    "npm:pi-omplike-advisor",
    "git:github.com/ZenkakuHiragana/pi-compact-transcript@local/both-fixes",
    {
      "source": "git:github.com/rytswd/pi-agent-extensions",
      "extensions": [
        "-direnv/index.ts",
        "-fetch/index.ts",
        "-notify/index.ts",
        "-permission-gate/index.ts",
        "-slow-mode/index.ts",
        "-statusline/index.ts"
      ]
    },
    "npm:@cortexkit/pi-magic-context",
    "npm:pi-context-view"
  ]
}
