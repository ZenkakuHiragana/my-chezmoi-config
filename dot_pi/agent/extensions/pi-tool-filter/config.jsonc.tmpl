{{- $bashDeny := list -}}
{{- range $pattern, $action := .opencode.permission.bash -}}
  {{- if eq $action "deny" -}}
    {{- $bashDeny = append $bashDeny $pattern -}}
  {{- end -}}
{{- end -}}
{
  // 共有設定とマシン固有設定を統合した read 規則。
  "read": {
    "allow": {{ .pi.tool_filter.read.allow | toPrettyJson }},
    "deny": {{ .pi.tool_filter.read.deny | toPrettyJson }}
  },
  // 共有設定とマシン固有設定を統合した write 規則。
  "write": {
    "allow": {{ .pi.tool_filter.write.allow | toPrettyJson }},
    "deny": {{ .pi.tool_filter.write.deny | toPrettyJson }},
    "outsideDefault": "{{ .pi.tool_filter.write.outsideDefault }}"
  },
  // bash の拒否規則は既存の OpenCode 共通設定から生成する。
  "bash": {
    "allow": [],
    "deny": {{ $bashDeny | toPrettyJson }}
  }
}
