{{- $readDeny := list "~/.ssh" "~/.ssh/**" "~/.bashrc" "~/.bash_profile" "~/.profile" "~/.zshrc" "~/.zprofile" "~/.aws" "~/.aws/**" "~/.config/gcloud" "~/.config/gcloud/**" "~/.kube/config" "~/.npmrc" "~/.pypirc" "~/.git-credentials" "~/.netrc" -}}
{{- $bashDeny := list -}}
{{- range $pattern, $action := .opencode.permission.bash -}}
  {{- if eq $action "deny" -}}
    {{- $bashDeny = append $bashDeny $pattern -}}
  {{- end -}}
{{- end -}}
{
  // 読み取りは通常許可する。資格情報に関わる共通拒否だけをここへ生成する。
  // allow はこの設定ファイルで管理し、deny より優先する。
  "read": {
    "allow": [],
    "deny": {{ $readDeny | toPrettyJson }}
  },
  // 作業ディレクトリ内は許可し、外側だけをこの規則と未一致時既定値で判定する。
  "write": {
    "allow": [],
    "deny": [],
    "outsideDefault": "deny"
  },
  // allow は個人設定。deny は共通の bash 拒否設定から生成し、PowerShellにも適用する。
  "bash": {
    "allow": [],
    "deny": {{ $bashDeny | toPrettyJson }}
  }
}
