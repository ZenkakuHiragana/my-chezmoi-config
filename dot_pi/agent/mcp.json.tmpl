{{- $sourceDir := .chezmoi.sourceDir -}}
{{- $servers := dict -}}
{{- range $name, $server := .opencode.mcp -}}
  {{- $type := dig "type" "" $server -}}
  {{- if eq $type "local" -}}
    {{- $command := get $server "command" -}}
    {{- $args := list -}}
    {{- range $arg := (slice $command 1) -}}
      {{- $args = append $args (replace "{file:~/.config/opencode/skill-kb-entrypoint.txt}" (joinPath $sourceDir "tools" "skill-kb" "dist" "src" "index.js") $arg) -}}
    {{- end -}}
    {{- $entry := dict "command" (index $command 0) "args" $args -}}
    {{- if hasKey $server "environment" -}}
      {{- $_ := set $entry "env" (get $server "environment") -}}
    {{- end -}}
    {{- if hasKey $server "cwd" -}}
      {{- $_ := set $entry "cwd" (get $server "cwd") -}}
    {{- end -}}
    {{- if hasKey $server "timeout" -}}
      {{- $_ := set $entry "requestTimeoutMs" (get $server "timeout") -}}
    {{- end -}}
    {{- if eq (dig "enabled" true $server) false -}}
      {{- $_ := set $entry "disabled" true -}}
    {{- end -}}
    {{- $_ := set $servers $name $entry -}}
  {{- else if eq $type "remote" -}}
    {{- $entry := dict "url" (get $server "url") -}}
    {{- if hasKey $server "headers" -}}
      {{- $_ := set $entry "headers" (get $server "headers") -}}
    {{- end -}}
    {{- if hasKey $server "timeout" -}}
      {{- $_ := set $entry "requestTimeoutMs" (get $server "timeout") -}}
    {{- end -}}
    {{- if hasKey $server "oauth" -}}
      {{- $_ := set $entry "oauth" (get $server "oauth") -}}
      {{- if ne (get $server "oauth") false -}}
        {{- $_ := set $entry "auth" "oauth" -}}
      {{- end -}}
    {{- end -}}
    {{- if eq (dig "enabled" true $server) false -}}
      {{- $_ := set $entry "disabled" true -}}
    {{- end -}}
    {{- $_ := set $servers $name $entry -}}
  {{- end -}}
{{- end -}}
{{- range $name, $server := .pi.mcp -}}
  {{- $_ := set $servers $name $server -}}
{{- end -}}
{{- dict "mcpServers" $servers | toPrettyJson -}}
