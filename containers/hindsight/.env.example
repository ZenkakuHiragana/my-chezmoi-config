# compose 補間用のローカル設定。コピーして .env を作る。秘密は入れない。
HINDSIGHT_DB_USER=hindsight
HINDSIGHT_DB_NAME=hindsight

# ホスト側の Codex 認証ディレクトリ（マシン固有の絶対パス）
HINDSIGHT_CODEX_AUTH_DIR=

# 使う LLM の構成。compose.yaml に llm/*.yaml を重ねる。
# Windows のセパレータは ";"。常用はここを書き換え、一時的なら -f で上書きする。
COMPOSE_FILE=compose.yaml;llm/codex.yaml

# secrets/db_password.txt : DB パスワード（1行）
# secrets/hindsight.env   : HINDSIGHT_API_DATABASE_URL を1行。
#                           OpenCode Go を使う場合は HINDSIGHT_API_LLM_API_KEY も。
