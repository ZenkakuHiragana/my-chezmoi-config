# compose 補間用のローカル設定。コピーして .env を作る。秘密は入れない。

# Meilisearch のデータディレクトリ（data.ms を置く。マシン固有の絶対パス）
MEILISEARCH_DATA_DIR=

# ここから下は、上書きファイルを読ませる PC だけ使う（README 参照）。
# COMPOSE_PATH_SEPARATOR の行と、その下の 2 組のどちらか 1 組の # を外す。
# 区切りを「,」に決めておくと、Windows でも Linux でも同じ書き方になる。
#COMPOSE_PATH_SEPARATOR=,

# GPU を使う組。EMBED_INDEX_GPU は nvidia-smi -L が表示する UUID（GPU-xxxxxxxx-...）
#COMPOSE_FILE=compose.yaml,compose.gpu.yaml
#EMBED_INDEX_GPU=

# 別の PC の GPU を借りる組。EMBED_INDEX_REMOTE はコンテナから届く ホスト:ポート
#COMPOSE_FILE=compose.yaml,compose.remote.yaml
#EMBED_INDEX_REMOTE=
